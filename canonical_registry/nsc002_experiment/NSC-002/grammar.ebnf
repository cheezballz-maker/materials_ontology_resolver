(* ASCII case-insensitive, entire original source, no whitespace. *)
name       = group, { "-", group }, "benzene" ;
group      = locants, "-", [ multiplier ], substituent ;
locants    = locant, { ",", locant } ;
locant     = "1" | "2" | "3" | "4" | "5" | "6" ;
multiplier = "di" | "tri" ;
substituent= "bromo" | "chloro" | "fluoro" | "iodo" | "nitro" ;
(* Semantic guards: one to three groups, one to six distinct positions;
   one group per substituent type; multiplier count equals locant count;
   neutral, single-component substituted benzene, no other tokens. *)
