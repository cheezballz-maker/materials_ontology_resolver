+package uk.ac.cam.ch.wwmm.opsin;
+import java.util.*;
+class TraceProbe {
+ static String raw;
+ static boolean selected, cloned;
+ static int attempts;
+ static List<String> parseXml;
+ static void parses(List<Element> ps){parseXml=new ArrayList<>();for(Element e:ps)parseXml.add(e.toXML());}
+ static IdentityHashMap<Element,Origin> origins;
+ static List<Event> events;
+ static class Origin {int start,end; String text; Origin(int s,int e,String t){start=s;end=e;text=t;}}
+ static class Event {Origin o; String kind,locant,owner; Atom a; boolean spare; int fragment;
+  Event(Element node,Element group,Fragment f,Atom atom,String loc){o=origins.get(node);kind=node.getName();owner=group.getValue();locant=loc;a=atom;spare=atom.hasSpareValency();fragment=System.identityHashCode(f);}}
+ static void reset(String s){raw=s;selected=false;cloned=false;attempts=0;parseXml=null;origins=new IdentityHashMap<>();events=new ArrayList<>();}
+ static void attempt(){attempts++;events.clear();selected=false;cloned=false;}
+ static void token(Element el,String word,String tokens,int offset,String token){
+  if(raw==null || !word.equalsIgnoreCase(tokens))return;
+  // Only exact, unique word occurrences: no substring-offset guess after normalization.
+  int base=raw.indexOf(word);
+  if(base<0 || raw.indexOf(word,base+1)>=0)return;
+  int s=base+offset,e=s+token.length();
+  if(e<=raw.length() && raw.substring(s,e).equalsIgnoreCase(token))origins.put(el,new Origin(s,e,raw.substring(s,e)));
+ }
+ static void copy(Element from,Element to){if(origins==null)return;Origin o=origins.get(from);if(o!=null)origins.put(to,o);}
+ static void applied(Element node,Element group,Fragment f,Atom atom,String loc){if((node.getName().equals("indicatedHydrogen") || node.getName().equals("addedHydrogen")))events.add(new Event(node,group,f,atom,loc));}
+ static String b64(String s){return s==null?"":Base64.getEncoder().encodeToString(s.getBytes(java.nio.charset.StandardCharsets.UTF_8));}
+ static void dump(OpsinResult r){
+  if(parseXml!=null){for(int i=0;i<parseXml.size();i++)System.out.println("P\t"+(i+1)+"\t"+(selected && attempts==i+1)+"\t"+b64(parseXml.get(i)));}
+  if(!selected || !r.getStatus().toString().equals("SUCCESS"))return;
+  for(Event e:events){Origin o=e.o; boolean exists=r.getStructure().getAtomList().contains(e.a);
+   System.out.println("E\t"+(o==null?-1:o.start)+"\t"+(o==null?-1:o.end)+"\t"+b64(o==null?null:o.text)+"\t"+b64(e.kind)+"\t"+b64(e.locant)+"\t"+b64(e.owner)+"\t"+e.a.getID()+"\t"+e.a.getElement()+"\t"+e.a.getCharge()+"\t"+e.spare+"\t"+exists+"\t"+cloned+"\t"+attempts+"\t"+e.fragment);
+  }
+ }
+}
