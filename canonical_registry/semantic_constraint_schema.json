{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSC source semantic constraints",
  "type": "object",
  "required": [
    "contract_id",
    "input_name",
    "scope_status",
    "parent",
    "source_claims",
    "operations",
    "structural_constraints",
    "completeness"
  ],
  "properties": {
    "contract_id": {
      "const": "NSC-001"
    },
    "input_name": {
      "type": "string"
    },
    "scope_status": {
      "enum": [
        "IN_CONTRACT",
        "OUT_OF_CONTRACT",
        "UNKNOWN"
      ]
    },
    "parent": {
      "type": [
        "object",
        "null"
      ],
      "description": "Numbered chemically defined parent template, not parser identity; null if scope cannot establish parent."
    },
    "source_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "structural_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "operation",
        "tautomer",
        "identity"
      ],
      "properties": {
        "operation": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "tautomer": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "identity": {
          "const": "NOT_ESTABLISHED"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "semantic_type",
        "source_span",
        "owner",
        "rule_id",
        "value",
        "dependencies"
      ],
      "properties": {
        "semantic_type": {
          "type": "string"
        },
        "source_span": {
          "type": "object",
          "required": [
            "start",
            "end",
            "text"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "owner": {
          "type": "string"
        },
        "rule_id": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "value": {},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "semantic_type",
        "owner",
        "assertion",
        "rule_id",
        "applicability",
        "dependencies",
        "result"
      ],
      "properties": {
        "semantic_type": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "assertion": {
          "type": "object"
        },
        "rule_id": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "applicability": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "enum": [
            "SUPPORTED",
            "DIFFERENT",
            "UNKNOWN",
            "NOT_EVALUATED"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Half-open Unicode-code-point spans in the original input; ownership is contract-local semantic fragment identity, not an OPSIN object ID. Validating the JSON schema does not validate chemistry."
}
